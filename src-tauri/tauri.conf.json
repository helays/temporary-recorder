{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "闪记",
  "version": "0.1.0",
  "identifier": "com.temporary.recorder",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "闪记",
        "width": 900,
        "height": 650,
        "minWidth": 480,
        "minHeight": 320,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["json", "jsonc"],
        "name": "TemporaryRecorder.json",
        "description": "JSON 文本（闪记）"
      },
      {
        "ext": ["yaml", "yml"],
        "name": "TemporaryRecorder.yaml",
        "description": "YAML 文本（闪记）"
      },
      {
        "ext": ["toml", "ini", "conf"],
        "name": "TemporaryRecorder.config",
        "description": "配置文件（闪记）"
      },
      {
        "ext": ["txt", "log"],
        "name": "TemporaryRecorder.text",
        "description": "纯文本（闪记）"
      },
      {
        "ext": ["md"],
        "name": "TemporaryRecorder.markdown",
        "description": "Markdown 文本（闪记）"
      },
      {
        "ext": ["csv"],
        "name": "TemporaryRecorder.csv",
        "description": "CSV 表格（闪记）"
      },
      {
        "ext": ["xml"],
        "name": "TemporaryRecorder.xml",
        "description": "XML 文本（闪记）"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
